if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "Standalone builds are supported on Linux only")
endif()
set(OS_LINUX TRUE)
set(ENABLE_BROWSER ON CACHE BOOL "Build browser plugin" FORCE)
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/standalone")
find_package(libobs REQUIRED)
if(libobs_VERSION VERSION_LESS 33)
  message(FATAL_ERROR "This standalone build targets the OBS 33+ SDK")
endif()
find_package(obs-frontend-api REQUIRED)
find_package(obs-websocket-api REQUIRED)
add_library(OBS::frontend-api ALIAS OBS::obs-frontend-api)
add_library(OBS::websocket-api ALIAS OBS::obs-websocket-api)
set(CMAKE_INCLUDE_CURRENT_DIR ON)
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
add_compile_definitions(ENABLE_WAYLAND)
include(GNUInstallDirs)
install(FILES "${PROJECT_SOURCE_DIR}/COPYING" DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/obs-browser-nvidia)

function(set_target_properties_obs target)
  set(i 2)
  while(i LESS ARGC)
    set(key "${ARGV${i}}")
    math(EXPR i "${i} + 1")
    set_property(TARGET ${target} PROPERTY "${key}" "${ARGV${i}}")
    math(EXPR i "${i} + 1")
  endwhile()
  if(target STREQUAL "obs-browser")
    install(TARGETS ${target} LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/obs-browser-nvidia)
    install(DIRECTORY "${PROJECT_SOURCE_DIR}/data/" DESTINATION ${CMAKE_INSTALL_DATADIR}/obs/obs-plugins/obs-browser)
  elseif(target STREQUAL "browser-helper")
    install(TARGETS ${target} RUNTIME DESTINATION ${CMAKE_INSTALL_LIBDIR}/obs-browser-nvidia)
  endif()
endfunction()
