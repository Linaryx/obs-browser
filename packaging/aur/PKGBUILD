pkgname=obs-browser-nvidia-git
pkgver=2.27.5
pkgrel=1
pkgdesc='Experimental CEF 156 NVIDIA DMA-BUF browser sources for OBS (opt-in launcher)'
arch=('x86_64')
url='https://github.com/Linaryx/obs-browser'
license=('GPL-2.0-or-later' 'BSD-3-Clause')
depends=('obs-studio>=33' 'obs-studio<34' 'qt6-base' 'qt6-wayland' 'libx11' 'libdrm'
         'libglvnd' 'bubblewrap' 'wayland' 'alsa-lib' 'at-spi2-core' 'cairo' 'libcups'
         'dbus' 'expat' 'glib2' 'gtk3' 'libxcomposite' 'libxdamage' 'libxext'
         'libxfixes' 'libxkbcommon' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango'
         'systemd-libs')
makedepends=('git' 'cmake' 'ninja' 'nlohmann-json' 'simde')
options=('!strip')
_repo=${OBS_BROWSER_FORK_URL:-https://github.com/Linaryx/obs-browser.git}
_cef='cef_binary_156.0.30+g6028375+chromium-156.0.8078.96_linux64_minimal'
source=("obs-browser::git+${_repo}#branch=experimental/nvidia-cef156"
        "${_cef}.tar.bz2::https://cef-builds.spotifycdn.com/${_cef//+/%2B}.tar.bz2")
sha256sums=('SKIP' '356db99d653698aa9ba78b22965032b4fa5b23ba079ffdbaa5d28a8530f04011')

pkgver() {
  cd "$srcdir/obs-browser"
  printf '2.27.5.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cmake -S "$srcdir/obs-browser" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCEF_ROOT_DIR="$srcdir/$_cef" -DOBS_BROWSER_BUILD_TESTS=OFF -DOBS_BROWSER_ENABLE_DEVTOOLS=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/$_cef/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/CEF-LICENSE.txt"
  install -Dm644 "$srcdir/obs-browser/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 "$srcdir/obs-browser/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
